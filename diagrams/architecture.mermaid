graph TD
    Client([Global Enterprise Traffic]) -->|HTTPS / WSS| CF[Cloudflare WAF & Edge Routing]
    
    subgraph Zero-Downtime Cluster
        CF -->|Validated Payloads| Proxy[Kamal Proxy]
        
        subgraph Edge Delivery Nodes
            Proxy -->|Atomic Routing| NextJS[Next.js 16 Standalone Containers]
        end
        
        subgraph Isolated Application Core
            Proxy -->|API Traffic| Laravel[Laravel 13 Core & Queue Workers]
            NextJS -->|Internal Fetches| Proxy
        end
        
        subgraph Stateful Persistence Layer
            Laravel -->|Strict Isolation| PG[(PostgreSQL 18)]
            Laravel -->|High-Concurrency| Redis[(Redis 8)]
            Laravel -->|Object Persistence| S3[(External S3-Compatible Nodes)]
        end
    end
    
    classDef proxy fill:#2563eb,stroke:#fff,stroke-width:2px,color:#fff;
    classDef edge fill:#f59e0b,stroke:#fff,stroke-width:2px,color:#fff;
    classDef core fill:#dc2626,stroke:#fff,stroke-width:2px,color:#fff;
    classDef data fill:#059669,stroke:#fff,stroke-width:2px,color:#fff;
    
    class Proxy proxy;
    class NextJS edge;
    class Laravel core;
    class PG,Redis,S3 data;
